*.tsbuildinfo

# Local agent/tooling state — machine-specific, and launch.json carries an
# absolute path to this machine's node binary.
.claude/

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Never commit a real token or a real dataset to the public app repo
data.json
*.pat
.env
.env.*
!.env.example

# Playwright
/test-results/
/playwright-report/

# Lighthouse output, regenerated by the command in docs/Rules.md section 5
lighthouse-report.report.*
/blob-report/
/playwright/.cache/

# Vendored OCR engine: ~14 MB of binaries copied from node_modules by
# scripts/vendor-ocr.mjs on every build. npm pins the versions; git should not
# carry the bytes.
public/tesseract/
